# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Not needed yet: the app runs on demo data until these are set.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used in invitation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
